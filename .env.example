# Copy this file to .env and fill in the values before running docker-compose or the app locally.
# Never commit your .env file to version control.

# ── Database ──────────────────────────────────────────────────────────────────

# Full PostgreSQL connection string.
# When using docker-compose the default value below matches the db service config.
DATABASE_URL=postgres://portfolio:localpassword@localhost:5432/portfolio

# Password for the local Postgres container (docker-compose only).
# Must match the password portion of DATABASE_URL above.
POSTGRES_PASSWORD=localpassword

# ── Clerk authentication ──────────────────────────────────────────────────────

# Secret key for the Clerk backend SDK (starts with sk_test_ or sk_live_).
# Found in the Clerk dashboard → API Keys.
CLERK_SECRET_KEY=sk_test_replace_me

# Publishable key used by the React frontend (starts with pk_test_ or pk_live_).
# Found in the Clerk dashboard → API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ── Access control ────────────────────────────────────────────────────────────

# Comma-separated list of email addresses that are granted editor access.
# Everyone else is a read-only viewer.
EDITOR_EMAILS=alice@example.com,bob@example.com

# Simple passcode that visitors must enter to view the dashboard (optional).
# Leave blank to disable the passcode gate.
VITE_TD_SITE_PASSCODE=

# ── Server ────────────────────────────────────────────────────────────────────

# Port the API server listens on.
PORT=3000

# Comma-separated list of origins the API allows for CORS.
ALLOWED_ORIGINS=http://localhost:5173

# Log level for the API server (trace | debug | info | warn | error | fatal).
LOG_LEVEL=info

# ── Admin auth (cookie-based, fallback when Clerk is not configured) ─────────
# Random secret used to sign session cookies (32+ bytes recommended).
TD_ADMIN_SESSION_SECRET=
# JSON array of admin accounts. Each entry: {username, password, firstName?, lastName?, email?, role?}
TD_ADMIN_ACCOUNTS=

# ── Frontend ─────────────────────────────────────────────────────────────────

# Base path for the Vite dev server and built assets (required by vite.config.ts).
# Use "/" for local development.
# NOTE: when running both the API and Vite locally, each process needs its own
# PORT value — see the README "Running locally" section for details.
BASE_PATH=/

# Base URL of the API server, as seen from the browser.
VITE_API_BASE_URL=http://localhost:3000
